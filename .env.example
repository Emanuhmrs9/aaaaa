# Shopee Affiliate Open API - Brasil
# A documentação oficial da Open API usa AppId + Secret.
# NÃO use senha da conta Shopee. NÃO coloque suas credenciais no frontend.

SHOPEE_APP_ID=
SHOPEE_SECRET=

# Opcional: até 5 SubIds separados por vírgula para rastrear campanhas.
# Exemplo: instagram,whatsapp,site
SHOPEE_SUB_IDS=

PORT=3000
